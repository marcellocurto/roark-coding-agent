{
  "name": "roark-coding-agent",
  "version": "0.3.0",
  "description": "A CLI for running coding agents against GitHub issues and pull requests.",
  "homepage": "https://agent.roark.at",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcellocurto/roark-coding-agent.git"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "roark.ts",
  "type": "module",
  "bin": {
    "roark": "./roark.ts"
  },
  "files": [
    "roark.ts",
    "lib",
    "skills",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "tsconfig.json"
  ],
  "scripts": {
    "start": "bun run roark.ts",
    "agent": "bun run roark.ts",
    "install-global": "bun install -g \"$PWD\"",
    "do": "bun run roark.ts do",
    "auto": "bun run roark.ts auto --repo marcellocurto/roark-coding-agent",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --cache-strategy content --cache-location .eslintcache",
    "lint:full": "eslint .",
    "check": "bun run typecheck && bun run lint && bun test",
    "release:check": "bun run check && bun run release:check-package",
    "release:check-package": "bun run scripts/check-package.ts",
    "version:patch": "bun run release:check && bun pm version patch",
    "version:minor": "bun run release:check && bun pm version minor",
    "version:major": "bun run release:check && bun pm version major"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "eslint": "^10.3.0",
    "typescript-eslint": "^8.59.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@effect/platform-bun": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "typebox": "1.1.38"
  }
}
